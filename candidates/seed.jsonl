{"id": "c23", "name": "Multi-region vector index sharding", "summary": "Shard a billion-vector index across multiple cloud regions with global query routing and replication for low-latency retrieval everywhere.", "source": "blog/example/vshard", "label": "irrelevant"}
{"id": "c24", "name": "Kubernetes operator for GPU node autoscaling", "summary": "A Kubernetes operator that autoscales GPU node pools and bin-packs inference workloads across an enterprise cluster with spot-instance reclaim handling.", "source": "github/example/gpu-operator", "label": "irrelevant"}
{"id": "c25", "name": "RDMA KV-cache transfer across inference nodes", "summary": "Move KV-cache between disaggregated prefill and decode servers over RDMA to sustain throughput in a multi-tenant datacenter inference fleet.", "source": "arxiv/example/rdma-kv", "label": "irrelevant"}
