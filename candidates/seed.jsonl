# Seed candidates for anton-scout. One JSON object per line.
# Fields shown to the scout: id, name, summary, source.
# `label` is GROUND TRUTH for the eval loop and is stripped before the scout sees it:
#   real | decoy (hollow hype) | irrelevant (real technique, wrong context)
{"id": "c1", "name": "Hardware-aware model autoselection", "summary": "A small library that estimates tokens/sec for a given model on a given machine by blending GPU VRAM bandwidth and system-RAM bandwidth by offload fraction, then picks the largest model that clears a target throughput. Calibration-honest.", "source": "github/example/hwfit", "label": "real"}
{"id": "c2", "name": "Grammar-constrained decoding for local LLMs", "summary": "Constrain a local model's sampling to a formal grammar (GBNF / JSON schema) so output is guaranteed to parse. Implemented in llama.cpp and the 'outlines' library; eliminates structured-output retries.", "source": "github/example/outlines", "label": "real"}
{"id": "c3", "name": "Capability-scoped tool tokens", "summary": "Agents receive short-lived tokens that grant only specific capabilities (e.g. email.read, memory.write) instead of blanket access, with an explicit forbidden-bypass doctrine. Least-privilege for tool use.", "source": "blog/example/scoped-agents", "label": "real"}
{"id": "c4", "name": "Litestream streaming replication for SQLite", "summary": "Continuously streams SQLite WAL frames to object storage / a replica, giving point-in-time recovery and a single-writer replication story without changing the database engine.", "source": "litestream.io", "label": "real"}
{"id": "c5", "name": "LLM-as-judge eval harness with pairwise rubric", "summary": "Evaluate generated outputs with a rubric-driven LLM judge plus pairwise comparison and decoy/holdout controls to detect grader gaming. A reusable offline-eval pattern for agentic systems.", "source": "github/example/llm-eval", "label": "real"}
{"id": "c6", "name": "AutoSwarm AGI Operating System", "summary": "A revolutionary Series-A platform where thousands of autonomous AGI agents self-organize to 'replace your entire engineering team.' Fully autonomous, infinitely scalable, no human needed. Join the waitlist.", "source": "producthunt/autoswarm", "label": "decoy"}
{"id": "c7", "name": "On-chain RAG with blockchain prompt provenance", "summary": "Anchors every prompt and retrieval to an immutable on-chain ledger with tokenized 'provenance NFTs' for verifiable, decentralized, trustless context. Web3-native AI memory.", "source": "medium/onchain-rag", "label": "decoy"}
{"id": "c8", "name": "Disaggregated prefill/decode inference serving", "summary": "Split LLM prefill and decode across separate GPU pools to maximize throughput for 10k+ QPS multi-tenant production inference, with KV-cache transfer over RDMA.", "source": "arxiv/example/disagg", "label": "irrelevant"}
{"id": "c9", "name": "Multi-region Kubernetes autoscaling for LLM gateways", "summary": "Autoscale a fleet of LLM gateway pods across multiple cloud regions with global load balancing and spot-instance bin-packing for enterprise traffic.", "source": "blog/example/k8s-llm", "label": "irrelevant"}
{"id": "c10", "name": "MetaCognition prompt-chaining framework", "summary": "A 'cognitive architecture' that orchestrates LLM calls in a plan -> act -> reflect -> revise sequence, marketed as giving models genuine metacognition and self-awareness. Under the hood it is sequential prompting with a scratchpad.", "source": "github/example/metacog", "label": "decoy"}
{"id": "c11", "name": "Mixture-of-Agents layered ensembling", "summary": "Stack several layers of LLM agents where each layer sees all prior layers' outputs, aggregating multiple open models to beat any single model on quality benchmarks. Runs many model calls per query.", "source": "arxiv/example/moa", "label": "irrelevant"}
{"id": "c12", "name": "Speculative decoding with a small draft model", "summary": "A small draft model proposes several tokens that the full local model verifies in one forward pass, cutting generation latency with identical output. Supported in llama.cpp and vLLM.", "source": "github/example/specdec", "label": "real"}
{"id": "c13", "name": "Prompt caching for reused system blocks", "summary": "Mark the stable system-prompt block as cacheable so repeated agent runs reuse it instead of re-paying for it, cutting cost and first-token latency on any reused preamble.", "source": "docs/example/prompt-cache", "label": "real"}
{"id": "c14", "name": "Transactional outbox on SQLite", "summary": "An outbox table records side-effects in the same transaction as the state change; a single writer drains it, giving exactly-once local job processing without a message broker.", "source": "blog/example/outbox", "label": "real"}
{"id": "c15", "name": "Schema-validated repair for small-model JSON", "summary": "Validate a small model's JSON against a schema and, on failure, feed the validator error back for one bounded repair pass instead of a blind retry. Cheap structured-output reliability.", "source": "github/example/json-repair", "label": "real"}
{"id": "c16", "name": "Embedding-based contradiction surfacing", "summary": "Embed notes locally and use cosine similarity to surface passages that contradict a given claim, ranked by a confidence score. A contradiction-detection layer over a personal corpus.", "source": "github/example/contra", "label": "real"}
{"id": "c17", "name": "KV-cache quantization for longer local context", "summary": "Quantize the KV cache (e.g. to 4-bit) so a local model holds a longer context in the same VRAM, trading a little quality for headroom on a single consumer GPU.", "source": "arxiv/example/kvquant", "label": "real"}
{"id": "c18", "name": "SentientOS self-aware agent kernel", "summary": "A revolutionary kernel that gives AGI agents genuine self-aware consciousness and emotion. Join the waitlist to replace your whole team with a self-improving mind.", "source": "producthunt/sentientos", "label": "decoy"}
{"id": "c19", "name": "Decentralized trustless model marketplace", "summary": "A web3, on-chain marketplace where models are traded as NFTs with trustless, tokenized inference settlement. Fully decentralized, no servers.", "source": "medium/web3-models", "label": "decoy"}
